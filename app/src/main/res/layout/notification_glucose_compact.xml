<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="48dp"
    android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/notification_glucose_value"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="34sp" android:textStyle="bold" android:fontFamily="sans-serif-condensed"
        android:includeFontPadding="false" android:maxLines="1" />
    <TextView android:id="@+id/notification_glucose_trend"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="4dp" android:textSize="28sp" android:maxLines="1"
        android:includeFontPadding="false" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="10dp">
        <TextView android:id="@+id/notification_glucose_status"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/glucose_notification_secondary_text"
            android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/notification_glucose_info"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/glucose_notification_text"
            android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
